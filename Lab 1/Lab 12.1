#include <stdio.h>
#include <stdlib.h>
#include <stdbool.h>

#define INF 999999

int *Dijkstra(int *L, int n) {
    static int distance[100]; 
    bool visited[100];
    
    for (int i = 0; i < n; i++) {
        distance[i] = INF;
        visited[i] = false;
    }
    
    distance[0] = 0;

    for (int count = 0; count < n; count++) {
        int min = INF, u = -1;
        for (int v = 0; v < n; v++) {
            if (!visited[v] && distance[v] <= min) {
                min = distance[v];
                u = v;
            }
        }

        if (u == -1) break;
        visited[u] = true;

        for (int v = 0; v < n; v++) {
            int weight = L[u * n + v];
            if (!visited[v] && weight != -1 && distance[u] != INF 
                && distance[u] + weight < distance[v]) {
                distance[v] = distance[u] + weight;
            }
        }
    }
    
    static int result[100];
    for(int i = 1; i < n; i++) {
        result[i-1] = distance[i];
    }
    
    return result;
}

int main() {
    int n = 5, i = 0, j = 0, *d, *g;
    
    g = (int *)malloc(n * n * sizeof(int));
    
    for(i = 0; i < n; i++)
        for(j = 0; j < n; j++)
            g[i * n + j] = -1;
            
    g[0*n+1] = 100; g[0*n+2] = 80;
    g[0*n+3] = 30;  g[0*n+4] = 10;
    g[1*n+2] = 20;  g[3*n+1] = 20;
    g[3*n+2] = 20;  g[4*n+3] = 10;
    
    d = Dijkstra(g, n);
    
    for(i = 0; i < n - 1; i++) {
        printf("%d ", d[i]);
    }
    printf("\n");

    free(g);
    return 0;
}
